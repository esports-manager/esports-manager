{
  "$defs": {
    "NameOrderDef": {
      "enum": [
        "given_first",
        "family_first"
      ],
      "type": "string"
    },
    "NationalityDef": {
      "additionalProperties": false,
      "description": "A nationality, in `nationalities/`.",
      "properties": {
        "$schema": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "description": "ISO 3166-1 alpha-2, such as `KR`.",
          "pattern": "^[A-Z]{2}$",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z_]+:[a-z0-9_]+$",
          "type": "string"
        },
        "name_order": {
          "$ref": "#/$defs/NameOrderDef"
        }
      },
      "required": [
        "id",
        "code",
        "name_order"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/NationalityDef"
    },
    {
      "items": {
        "$ref": "#/$defs/NationalityDef"
      },
      "type": "array"
    }
  ],
  "description": "A nationality, in `nationalities/`.",
  "title": "NationalityDef"
}
