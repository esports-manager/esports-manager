{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorldDef",
  "description": "`world.json`.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "start_date": {
      "description": "The first day of the game, as `YYYY-MM-DD`.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "start_date"
  ]
}
